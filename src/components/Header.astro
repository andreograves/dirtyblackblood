---
import { site, nav } from '../site.config';
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container inner">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header { border-bottom: 1px solid var(--border); }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .brand {
    font-family: var(--font-display);
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  ul { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); text-transform: uppercase; font-size: 0.875rem; letter-spacing: 0.08em; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
</style>
