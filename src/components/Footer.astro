---
import { site, socials } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container inner">
    <p>&copy; {year} {site.name}</p>
    {socials.length > 0 && (
      <ul>
        {socials.map((s) => (
          <li><a href={s.href} rel="noopener" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 0.875rem; }
  .inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  p { margin: 0; }
  ul { display: flex; gap: 1rem; list-style: none; margin: 0; padding: 0; }
</style>
