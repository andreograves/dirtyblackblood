---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title="Contact">
  <section class="container page">
    <h1>Contact</h1>
    {site.email
      ? <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      : <p class="placeholder">Placeholder: add the contact email in <code>src/site.config.ts</code>.</p>}
  </section>
</Base>

<style>
  .page { padding-top: 3rem; padding-bottom: 4rem; }
  h1 { font-size: clamp(2rem, 6vw, 3.5rem); text-transform: uppercase; }
</style>
